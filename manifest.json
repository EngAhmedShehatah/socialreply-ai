{
  "manifest_version": 3,
  "name": "SocialReply AI",
  "version": "1.0.0",
  "description": "Suggest AI replies for LinkedIn, Reddit, and Facebook comments.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.reddit.com/*",
    "https://www.facebook.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["core/api.js", "platforms/linkedin/content.js"]
    },
    {
      "matches": ["https://www.reddit.com/*"],
      "js": ["core/api.js", "platforms/reddit/content.js"]
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["core/api.js", "platforms/facebook/content.js"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_icon": "icon.png"
  }
}
